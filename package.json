{
  "name": "postgraphile-plugin-atomic-mutations",
  "version": "2.0.0",
  "description": "PostGraphile v4 and v5 plugin that makes all mutations of a GraphQL request atomic",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "check:package": "publint --pack npm && attw --pack .",
    "prepack": "node --run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmperorRXF/postgraphile-plugin-atomic-mutations.git"
  },
  "keywords": [
    "postgraphile",
    "graphile",
    "graphile-build",
    "grafast",
    "plugin",
    "graphql",
    "transaction",
    "atomic"
  ],
  "author": "Ruwan Xaviour Fernando",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EmperorRXF/postgraphile-plugin-atomic-mutations/issues"
  },
  "homepage": "https://github.com/EmperorRXF/postgraphile-plugin-atomic-mutations",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v5": {
      "types": "./dist/v5/index.d.ts",
      "default": "./dist/v5/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "v5": [
        "dist/v5/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "graphile-utils": "^4.7.0",
    "graphql": "^15.0.0 || ^16.0.0",
    "postgraphile": "^5.0.0"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@dataplan/pg": "^1",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5",
    "grafast": "^1",
    "grafserv": "^1",
    "graphile-config": "^1",
    "graphql": "^16",
    "oxlint": "^1",
    "oxlint-tsgolint": "^7.0.2006",
    "pg": "^8",
    "postgraphile": "^5.2.1",
    "prettier": "^3",
    "publint": "^0.3.25",
    "rimraf": "^6",
    "typescript": "^7.0.2",
    "vite": "^8",
    "vitest": "^5"
  },
  "workspaces": [
    "test/*"
  ],
  "peerDependenciesMeta": {
    "graphile-utils": {
      "optional": true
    },
    "postgraphile": {
      "optional": true
    }
  }
}
